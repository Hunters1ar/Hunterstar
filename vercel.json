{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "opener.hunterstar.uz"
        }
      ],
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "queue.hunterstar.uz"
        }
      ],
      "destination": "/accountqueue",
      "permanent": false
    },
    {
      "source": "/accountqueue.html",
      "has": [
        {
          "type": "host",
          "value": "hunterstar.uz"
        }
      ],
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/accountqueue",
      "has": [
        {
          "type": "host",
          "value": "hunterstar.uz"
        }
      ],
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/accountqueue.html",
      "has": [
        {
          "type": "host",
          "value": "www.hunterstar.uz"
        }
      ],
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/accountqueue",
      "has": [
        {
          "type": "host",
          "value": "www.hunterstar.uz"
        }
      ],
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/admin",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/admin.html",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "admin.hunterstar.uz"
        }
      ],
      "destination": "https://hunterstar.uz/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "admin.hunterstar.uz"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "opener.hunterstar.uz"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/opener",
      "destination": "/404.html"
    },
    {
      "source": "/opener.html",
      "destination": "/404.html"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "opener.hunterstar.uz"
        }
      ],
      "destination": "/404.html"
    },
    {
      "source": "/archives",
      "destination": "/archives.html"
    },
    {
      "source": "/me",
      "destination": "/me.html"
    },
    {
      "source": "/eduventure",
      "destination": "/projects/eduventure.html"
    }
  ]
}
